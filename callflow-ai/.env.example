# Environment Variables for CallFlow AI
# Copy this file to .env and fill in your values.

# --- DATABASE ---
# SQLite for local dev (default). For production, switch to PostgreSQL.
DATABASE_URL="file:./dev.db"

# --- VAPI AI ---
# Get these from https://dashboard.vapi.ai
VAPI_PRIVATE_API_KEY=your_vapi_private_key_here
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# --- GROQ (via Vapi) ---
# Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- APP ---
NEXTAUTH_SECRET=your_random_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- WEBHOOK ---
# This is the URL Vapi will POST events to.
# In production: https://yourdomain.com/api/webhooks/vapi
# For local testing use ngrok: https://abc123.ngrok.io/api/webhooks/vapi
VAPI_WEBHOOK_URL=http://localhost:3000/api/webhooks/vapi

